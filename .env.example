# Copy this file to .env and replace every password placeholder before starting.
POSTGRES_DB=project_management
POSTGRES_USER=project_manager
POSTGRES_PASSWORD=replace_with_a_random_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Production Compose publishes only the frontend. Keep 127.0.0.1 behind a host reverse proxy.
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8080

VALKEY_PASSWORD=replace_with_a_random_valkey_password
VALKEY_PORT=6379

# Login failures are counted by backend source address plus normalized username.
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ENTRIES=10000

# Local development uses the application's HTTP default (false).
# Production Compose defaults this setting to true; do not disable it behind HTTPS.

# Local development file storage. Production should use a persistent mounted directory.
FILE_STORAGE_ROOT=./data/files
# Fixed upload chunk size in bytes. Keep backend and reverse-proxy limits aligned with it.
FILE_CHUNK_SIZE_BYTES=5242880

# Base64 of exactly 32 random bytes, for example generated with: openssl rand -base64 32
# Keep the existing key available while old credentials still use its key version.
SERVER_CREDENTIAL_MASTER_KEY=replace_with_base64_encoded_32_byte_random_key
SERVER_CREDENTIAL_KEY_VERSION=v1

# Used only when app_user is empty. Remove these three lines after the first successful start.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_admin_password
INITIAL_ADMIN_DISPLAY_NAME=系统管理员
